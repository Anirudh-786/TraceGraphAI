# TraceGraphAI Backend Environment Configuration
# All values have sane local development defaults

# Server Port (Render injects PORT automatically)
PORT=8080

# FalkorDB Database Configuration
# Local Docker (default):
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_GRAPH=tracegraph

# Remote Hosted FalkorDB (e.g. FalkorDB Cloud: https://app.falkordb.cloud)
# FALKORDB_HOST=your-instance.falkordb.cloud
# FALKORDB_PORT=6379
# FALKORDB_USERNAME=default
# FALKORDB_PASSWORD=your_secure_password
# Or full connection URI:
# FALKORDB_URL=rediss://default:your_password@your-instance.falkordb.cloud:6379

# CORS Allowed Origins (include your deployed Vercel URL)
CORS_ALLOWED_ORIGINS=https://tracegraphai.vercel.app,http://localhost:5173

# AI Inference Copilot Configuration
# Local development with Ollama:
AI_INFERENCE_URL=http://localhost:11434
AI_INFERENCE_MODEL=llama3.2:3b

# Production remote inference (e.g. Groq, OpenRouter, or hosted vLLM):
# AI_INFERENCE_URL=https://api.groq.com/openai/v1
# AI_INFERENCE_MODEL=llama-3.1-8b-instant
# AI_INFERENCE_API_KEY=gsk_...

# Auto-seed graph on startup (false by default to prevent unexpected mutations)
GRAPH_SEED_ON_STARTUP=false
